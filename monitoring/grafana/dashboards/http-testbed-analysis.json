      "id": 5,
      "title": "Caddy CPU (%) — sustained, by scenario × protocol",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
