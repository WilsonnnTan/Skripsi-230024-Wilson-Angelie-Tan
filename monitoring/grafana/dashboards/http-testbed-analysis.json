{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "description": "Values are the exact per-run results published by h2load-exporter as h2load_final_* (same code and PromQL as scripts/export_results.sh), averaged over the repetitions. They reproduce results/summary_aggregated.csv. The time range only needs to end after the last run.",
  "panels": [
    {
      "id": 10,
      "title": "How to read this dashboard",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Aggregate analysis (sustained phase).** Set the time range to your campaign window. Bars = one value per protocol×scenario aggregated over that range. These are *exploratory* aggregates of the h2load-exporter's live rolling stream; the authoritative mean±std for the thesis is `results/summary_aggregated.csv` (and per-phase detail in `results/summary_by_phase.csv`), which are computed EXACTLY from the merged per-request logs. Server CPU/mem (Caddy, Backend) is untagged in cAdvisor; it is aligned to each run by masking on the h2load sustained-phase request rate. Latency bars show the dashboard's average of the exporter's rolling percentile snapshots, not the exact per-run percentiles."
      }
    },
    {
      "id": 1,
      "title": "Throughput (req/s) — by scenario, grouped by protocol",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "http1.1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http3"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "auto",
        "xField": "scenario",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (protocol, scenario) (h2load_final_throughput_rps)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "scenario"
              }
            ]
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "protocol",
            "rowField": "scenario",
            "valueField": "Value"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "scenario\\protocol"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "scenario\\protocol": 0,
              "http1.1": 1,
              "http2": 2,
              "http3": 3
            }
          }
        }
      ]
    },
