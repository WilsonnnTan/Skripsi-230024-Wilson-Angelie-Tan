          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (protocol, scenario) (avg_over_time((sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"caddy\"}[30s])) * 100 * on() group_left(protocol, scenario, repetition) (max by (protocol, scenario, repetition) (rate(k6_reqs_total{phase=\"sustained\"}[5s]) > 0) * 0 + 1))[$__range:5s]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
