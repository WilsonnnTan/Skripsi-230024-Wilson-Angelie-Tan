# =============================================================================
# Copy this file to `.env` and adjust if needed:  cp .env.example .env
# Docker Compose reads `.env` automatically from the project root.
# =============================================================================

# --- Grafana login (change for anything beyond a closed testbed) ------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Experiment tuning (all optional; the defaults below are used verbatim
#     by scripts/run_experiments.sh if these are exported into the shell) ----
# Number of repetitions per protocol x scenario (methodology: 10).
REPETITIONS=10
# Seconds to wait after applying a tc rule before starting k6.
STABILIZE_SECONDS=3
# Seconds between runs (drain TIME_WAIT sockets / reset state).
COOLDOWN_SECONDS=8
# Attempts per run before it is marked failed and skipped.
MAX_ATTEMPTS=2
# Skip runs that already have a successful summary file (1 = resume).
RESUME=1

# --- Prometheus / export ----------------------------------------------------
PROM_URL=http://localhost:9090
# cAdvisor CPU rate window and sub-query step used by export_results.sh.
CPU_RATE_WINDOW=30s
QUERY_STEP=5s

# --- CPU pinning (Batasan #2: system-under-test on P-cores, never E-cores) ---
# Defaults target an MSI i7-12650H, where logical CPUs 0-11 are the 6 P-cores
# (2 threads each) and 12-15 are the 4 E-cores. VERIFY YOUR OWN MAPPING with:
#     lscpu -e        # look at the CORE / MAXMHZ columns; E-cores run slower
# (run it inside WSL2 if you are on Windows) and adjust the ranges below.
#
#   backend + caddy  = system under test  -> distinct P-cores, never shared
#   k6               = load generator     -> its own P-cores (isolation)
#   support          = docker-tc + cadvisor + prometheus + grafana
#
# IMPORTANT (WSL2 / Docker Desktop): a container cpuset pins to the WSL2 VM's
# CPUs, but Windows can still migrate those vCPU threads across P/E cores, so
# docker cpuset ALONE does not guarantee host P-core placement. For a strict
# batasan #2 either (a) run this stack on native Linux, or (b) pin the WSL2 VM
# (vmmemWSL) to the host P-cores via Windows CPU affinity. Otherwise treat the
# pinning below as best-effort and note the limitation in the thesis.
CPUSET_BACKEND=0-1
CPUSET_CADDY=2-3
CPUSET_K6=4-7
CPUSET_SUPPORT=8-11
